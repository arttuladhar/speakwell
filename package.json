{
  "name": "public-speaking-workshop",
  "version": "1.0.0",
  "description": "Interactive 10-day public speaking workshop with SQLite progress tracking",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:api": "node tests/progress-update.cjs",
    "test:e2e": "npm run test:auth-flow && npm run test:user-flow",
    "test:progress-update": "node tests/progress-update.cjs",
    "test:user-flow": "node tests/user-flow.cjs",
    "test:auth-flow": "node tests/auth-flow.cjs",
    "test:hooks": "node .github/hooks/pre-commit-validation.test.cjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "express": "^4.19.2",
    "pg": "^8.23.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
